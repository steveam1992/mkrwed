# Hosting con Apache (cPanel y similares): devuelve index.html en cualquier
# ruta para que /precios o /productos/mkrcart funcionen al recargar.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
